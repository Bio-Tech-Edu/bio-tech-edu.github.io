+/* Estilos exclusivos do blog (blog.html e páginas de publicação). Carregado depois de styles.css. */
+.blog-hero{padding:56px 0 24px;display:grid;gap:12px;max-width:760px}
+.blog-hero h1{font-size:clamp(1.9rem,4vw,2.8rem);line-height:1.15;margin:0}
+.blog-hero p{color:var(--muted);margin:0;font-size:1.05rem}
+.carousel{border:1px solid var(--line);border-radius:var(--radius);background:var(--card);overflow:hidden;box-shadow:var(--shadow-soft)}
+.carousel[hidden],.carousel-ctrl[hidden]{display:none}
+.slide{display:grid;grid-template-columns:1fr 1fr;min-height:320px}
+.slide[hidden]{display:none}
+.slide-media{min-height:200px;background:linear-gradient(135deg,var(--green-soft),var(--aqua-soft))}
+.slide-media img{width:100%;height:100%;object-fit:cover;display:block}
+.slide-body{padding:32px;display:flex;flex-direction:column;gap:12px;justify-content:center;align-items:flex-start}
+.slide-body h3{font-size:clamp(1.3rem,2.4vw,1.9rem);line-height:1.2;margin:0}
+.slide-body h3 a,.post-card h3 a{color:inherit;text-decoration:none}
+.slide-body h3 a:hover,.post-card h3 a:hover{text-decoration:underline}
+.slide-body p{margin:0;color:var(--muted)}
+.carousel-ctrl{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 16px;border-top:1px solid var(--line)}
+.icon-btn{min-width:44px;min-height:44px;border-radius:999px;border:1px solid var(--line-strong);background:var(--card);color:var(--text);font:inherit;font-size:1.3rem;cursor:pointer}
+.dots{display:flex}
+.dots button{width:44px;height:44px;border:0;background:none;cursor:pointer;display:grid;place-items:center}
+.dots button::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--line-strong)}
+.dots button[aria-current="true"]::before{background:var(--accent);width:14px;height:14px}
+.blog-layout{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:32px;align-items:start;padding:40px 0 72px}
+.blog-main h2{margin:0 0 16px;font-size:1.5rem}
+.blog-search{display:grid;gap:6px;max-width:460px;margin-bottom:12px}
+.blog-search label{font-size:.85rem;font-weight:600;color:var(--muted)}
+.blog-search input{min-height:44px;padding:0 14px;border-radius:var(--radius-sm);border:1px solid var(--line-strong);background:var(--card);color:var(--text);font:inherit}
+.active-filters{display:flex;flex-wrap:wrap;gap:8px}
+.chip-btn{min-height:44px;padding:0 14px;border-radius:999px;border:1px solid var(--line-strong);background:var(--green-soft);color:var(--text);font:inherit;font-size:.9rem;cursor:pointer}
+.result-count{color:var(--muted);font-size:.9rem;margin:8px 0 16px}
+.post-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-bottom:24px}
+.post-card{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:var(--radius);background:var(--card);overflow:hidden}
+.post-cover{aspect-ratio:16/9;width:100%;object-fit:cover;display:block;background:linear-gradient(135deg,var(--green-soft),var(--aqua-soft))}
+.post-card-body{padding:18px;display:flex;flex-direction:column;gap:10px;flex:1}
+.post-card h3{margin:0;font-size:1.15rem;line-height:1.3}
+.post-card p{margin:0;color:var(--muted)}
+.post-card .more{margin-top:auto;min-height:44px;display:inline-flex;align-items:center;font-weight:600;color:var(--cyan)}
+.blog-side{display:grid;gap:20px}
+.side-card{border:1px solid var(--line);border-radius:var(--radius);background:var(--card);padding:20px}
+.side-card h2{font-size:1.05rem;margin:0 0 12px}
+.side-card p{margin:0 0 12px;color:var(--muted)}
+.facet{display:grid;gap:4px}
+.facet button{display:flex;justify-content:space-between;align-items:center;gap:8px;width:100%;min-height:44px;padding:0 12px;border-radius:var(--radius-sm);border:1px solid transparent;background:transparent;color:var(--text);font:inherit;text-align:left;cursor:pointer}
+.facet button:hover,.facet button[aria-pressed="true"]{background:var(--green-soft);border-color:var(--line-strong)}
+.facet .count{font-size:.8rem;color:var(--muted)}
+.tag-cloud{display:flex;flex-wrap:wrap;gap:8px}
+.tag-cloud button{min-height:44px;padding:0 12px;border-radius:999px;border:1px solid var(--line);background:transparent;color:var(--text);font:inherit;font-size:.85rem;cursor:pointer}
+.tag-cloud button:hover,.tag-cloud button[aria-pressed="true"]{background:var(--aqua-soft);border-color:var(--line-strong)}
+.media-links{list-style:none;margin:0 0 8px;padding:0;display:grid;gap:4px}
+.media-links a,.side-card .text-link{min-height:44px;display:inline-flex;align-items:center;color:var(--cyan);font-weight:600}
+.post{max-width:820px;padding:48px 0 72px}
+.crumbs{font-size:.9rem;color:var(--muted);margin-bottom:16px}
+.crumbs a{color:var(--cyan)}
+.post h1{font-size:clamp(1.8rem,4vw,2.6rem);line-height:1.15;margin:12px 0}
+.post-cover-fig{margin:24px 0}
+.post-cover-fig img{width:100%;height:auto;border-radius:var(--radius);display:block}
+.prose{line-height:1.75;font-size:1.05rem;max-width:72ch;margin-top:24px}
+.prose h2{margin:2rem 0 .5rem}
+.prose h3{margin:1.5rem 0 .4rem}
+.prose a{color:var(--cyan);text-decoration:underline}
+.prose img{max-width:100%;height:auto;border-radius:var(--radius-sm)}
+.prose pre{overflow-x:auto;padding:16px;border-radius:var(--radius-sm);background:var(--bg-strong);border:1px solid var(--line)}
+.prose blockquote{margin:1.2rem 0;padding:4px 16px;border-left:4px solid var(--accent);color:var(--muted)}
+.prose table{border-collapse:collapse;display:block;overflow-x:auto}
+.prose th,.prose td{border:1px solid var(--line);padding:8px 12px}
+.post-foot{margin-top:40px;padding-top:20px;border-top:1px solid var(--line);display:grid;gap:16px}
+.post-tags{display:flex;flex-wrap:wrap;gap:8px}
+.post-tags a{min-height:44px;display:inline-flex;align-items:center;padding:0 14px;border-radius:999px;border:1px solid var(--line-strong);color:var(--text);text-decoration:none}
+@media (max-width:980px){.blog-layout{grid-template-columns:1fr}.slide{grid-template-columns:1fr}.post-list{grid-template-columns:1fr}}
+
+.format-tag{display:inline-block;font-size:.75rem;font-weight:700;padding:3px 10px;border-radius:999px;border:1px solid var(--line-strong);color:var(--text);margin-left:6px}
+.card-tags{display:flex;flex-wrap:wrap;align-items:center;gap:4px}
+.media-links li{display:grid}
+.media-links small{color:var(--muted);margin:-6px 0 6px}
+.toc{border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--card);padding:4px 16px;margin:24px 0;max-width:72ch}
+.toc summary{cursor:pointer;min-height:44px;display:flex;align-items:center;font-weight:700}
+.toc ol{margin:0 0 12px;padding-left:20px;display:grid;gap:2px}
+.toc a{min-height:32px;display:inline-flex;align-items:center;color:var(--cyan)}
+.toc .sub{list-style:circle;margin-left:12px}
+.skill-list.inline{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}
+.post-aside{display:grid;gap:12px;margin:24px 0;max-width:72ch}
+.cite{border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:var(--radius-sm);background:var(--card);padding:16px;margin-top:32px;max-width:72ch}
+.cite h2{font-size:1.05rem;margin:0 0 8px}
+.cite p{margin:0 0 12px;overflow-wrap:anywhere}
+.comments{margin-top:40px;padding-top:24px;border-top:1px solid var(--line);max-width:72ch}
+.comments h2{margin:0 0 8px}
+.comments-status{color:var(--muted);margin:0 0 12px}
+.comments a{color:var(--cyan)}
+.related{margin-top:48px}
+.related h2{margin:0 0 16px}
+.related .post-list{grid-template-columns:repeat(3,minmax(0,1fr))}
+.post-nav{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:32px}
+.post-nav a{display:grid;gap:4px;padding:14px 16px;min-height:44px;border:1px solid var(--line);border-radius:var(--radius-sm);color:var(--text);text-decoration:none;background:var(--card)}
+.post-nav a:hover{border-color:var(--line-strong)}
+.post-nav small{color:var(--muted)}
+.post-nav .next{text-align:right}
+.notfound{padding:96px 0;text-align:center;display:grid;gap:16px;justify-items:center}
+@media (max-width:980px){.related .post-list{grid-template-columns:1fr}.post-nav{grid-template-columns:1fr}}
diff --git a/assets/styles.css b/assets/css/styles.css
similarity index 76%
rename from assets/styles.css
rename to assets/css/styles.css
index cc93b3d..8648e1a 100644
--- a/assets/styles.css
+++ b/assets/css/styles.css
@@ -846,70 +846,3 @@ a:focus-visible,button:focus-visible,input:focus-visible,summary:focus-visible{o
 .nav a[aria-current="page"]{color:var(--text);box-shadow:inset 0 -2px 0 var(--accent)}
 .meta{font-size:.85rem;color:var(--muted);margin:0}
 .empty{padding:24px;border:1px dashed var(--line-strong);border-radius:var(--radius);color:var(--muted);margin:0}
-.blog-hero{padding:56px 0 24px;display:grid;gap:12px;max-width:760px}
-.blog-hero h1{font-size:clamp(1.9rem,4vw,2.8rem);line-height:1.15;margin:0}
-.blog-hero p{color:var(--muted);margin:0;font-size:1.05rem}
-.carousel{border:1px solid var(--line);border-radius:var(--radius);background:var(--card);overflow:hidden;box-shadow:var(--shadow-soft)}
-.carousel[hidden],.carousel-ctrl[hidden]{display:none}
-.slide{display:grid;grid-template-columns:1fr 1fr;min-height:320px}
-.slide[hidden]{display:none}
-.slide-media{min-height:200px;background:linear-gradient(135deg,var(--green-soft),var(--aqua-soft))}
-.slide-media img{width:100%;height:100%;object-fit:cover;display:block}
-.slide-body{padding:32px;display:flex;flex-direction:column;gap:12px;justify-content:center;align-items:flex-start}
-.slide-body h3{font-size:clamp(1.3rem,2.4vw,1.9rem);line-height:1.2;margin:0}
-.slide-body h3 a,.post-card h3 a{color:inherit;text-decoration:none}
-.slide-body h3 a:hover,.post-card h3 a:hover{text-decoration:underline}
-.slide-body p{margin:0;color:var(--muted)}
-.carousel-ctrl{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 16px;border-top:1px solid var(--line)}
-.icon-btn{min-width:44px;min-height:44px;border-radius:999px;border:1px solid var(--line-strong);background:var(--card);color:var(--text);font:inherit;font-size:1.3rem;cursor:pointer}
-.dots{display:flex}
-.dots button{width:44px;height:44px;border:0;background:none;cursor:pointer;display:grid;place-items:center}
-.dots button::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--line-strong)}
-.dots button[aria-current="true"]::before{background:var(--accent);width:14px;height:14px}
-.blog-layout{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:32px;align-items:start;padding:40px 0 72px}
-.blog-main h2{margin:0 0 16px;font-size:1.5rem}
-.blog-search{display:grid;gap:6px;max-width:460px;margin-bottom:12px}
-.blog-search label{font-size:.85rem;font-weight:600;color:var(--muted)}
-.blog-search input{min-height:44px;padding:0 14px;border-radius:var(--radius-sm);border:1px solid var(--line-strong);background:var(--card);color:var(--text);font:inherit}
-.active-filters{display:flex;flex-wrap:wrap;gap:8px}
-.chip-btn{min-height:44px;padding:0 14px;border-radius:999px;border:1px solid var(--line-strong);background:var(--green-soft);color:var(--text);font:inherit;font-size:.9rem;cursor:pointer}
-.result-count{color:var(--muted);font-size:.9rem;margin:8px 0 16px}
-.post-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-bottom:24px}
-.post-card{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:var(--radius);background:var(--card);overflow:hidden}
-.post-cover{aspect-ratio:16/9;width:100%;object-fit:cover;display:block;background:linear-gradient(135deg,var(--green-soft),var(--aqua-soft))}
-.post-card-body{padding:18px;display:flex;flex-direction:column;gap:10px;flex:1}
-.post-card h3{margin:0;font-size:1.15rem;line-height:1.3}
-.post-card p{margin:0;color:var(--muted)}
-.post-card .more{margin-top:auto;min-height:44px;display:inline-flex;align-items:center;font-weight:600;color:var(--cyan)}
-.blog-side{display:grid;gap:20px}
-.side-card{border:1px solid var(--line);border-radius:var(--radius);background:var(--card);padding:20px}
-.side-card h2{font-size:1.05rem;margin:0 0 12px}
-.side-card p{margin:0 0 12px;color:var(--muted)}
-.facet{display:grid;gap:4px}
-.facet button{display:flex;justify-content:space-between;align-items:center;gap:8px;width:100%;min-height:44px;padding:0 12px;border-radius:var(--radius-sm);border:1px solid transparent;background:transparent;color:var(--text);font:inherit;text-align:left;cursor:pointer}
-.facet button:hover,.facet button[aria-pressed="true"]{background:var(--green-soft);border-color:var(--line-strong)}
-.facet .count{font-size:.8rem;color:var(--muted)}
-.tag-cloud{display:flex;flex-wrap:wrap;gap:8px}
-.tag-cloud button{min-height:44px;padding:0 12px;border-radius:999px;border:1px solid var(--line);background:transparent;color:var(--text);font:inherit;font-size:.85rem;cursor:pointer}
-.tag-cloud button:hover,.tag-cloud button[aria-pressed="true"]{background:var(--aqua-soft);border-color:var(--line-strong)}
-.media-links{list-style:none;margin:0 0 8px;padding:0;display:grid;gap:4px}
-.media-links a,.side-card .text-link{min-height:44px;display:inline-flex;align-items:center;color:var(--cyan);font-weight:600}
-.post{max-width:820px;padding:48px 0 72px}
-.crumbs{font-size:.9rem;color:var(--muted);margin-bottom:16px}
-.crumbs a{color:var(--cyan)}
-.post h1{font-size:clamp(1.8rem,4vw,2.6rem);line-height:1.15;margin:12px 0}
-.post-cover-fig{margin:24px 0}
-.post-cover-fig img{width:100%;height:auto;border-radius:var(--radius);display:block}
-.prose{line-height:1.75;font-size:1.05rem;max-width:72ch;margin-top:24px}
-.prose h2{margin:2rem 0 .5rem}
-.prose h3{margin:1.5rem 0 .4rem}
-.prose a{color:var(--cyan);text-decoration:underline}
-.prose img{max-width:100%;height:auto;border-radius:var(--radius-sm)}
-.prose pre{overflow-x:auto;padding:16px;border-radius:var(--radius-sm);background:var(--bg-strong);border:1px solid var(--line)}
-.prose blockquote{margin:1.2rem 0;padding:4px 16px;border-left:4px solid var(--accent);color:var(--muted)}
-.prose table{border-collapse:collapse;display:block;overflow-x:auto}
-.prose th,.prose td{border:1px solid var(--line);padding:8px 12px}
-.post-foot{margin-top:40px;padding-top:20px;border-top:1px solid var(--line);display:grid;gap:16px}
-.post-tags{display:flex;flex-wrap:wrap;gap:8px}
-.post-tags a{min-height:44px;display:inline-flex;align-items:center;padding:0 14px;border-radius:999px;border:1px solid var(--line-strong);color:var(--text);text-decoration:none}
-@media (max-width:980px){.blog-layout{grid-template-columns:1fr}.slide{grid-template-columns:1fr}.post-list{grid-template-columns:1fr}}
