+  margin-top: auto;
+  display: flex;
+  gap: 10px;
+  flex-wrap: wrap;
+  padding-top: 10px;
+}
+
+.link-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 40px;
+  padding: 0 14px;
+  border-radius: 10px;
+  border: 1px solid var(--line);
+  font-size: 0.87rem;
+  font-weight: 600;
+  transition: transform 0.2s ease, border-color 0.2s ease;
+}
+
+.link-btn.primary {
+  background: linear-gradient(135deg, rgba(73,217,160,0.16), rgba(120,223,255,0.08));
+  border-color: rgba(73,217,160,0.24);
+}
+
+.link-btn.secondary {
+  background: rgba(255,255,255,0.02);
+}
+
+.link-btn.muted {
+  background: rgba(255,255,255,0.02);
+  color: var(--muted);
+  cursor: default;
+}
+
+.link-btn:hover {
+  transform: translateY(-1px);
+}
+
+.empty-state {
+  grid-column: 1 / -1;
+  padding: 36px 24px;
+  text-align: center;
+  border: 1px dashed rgba(173, 229, 213, 0.22);
+  border-radius: var(--radius);
+  background: rgba(255,255,255,0.02);
+}
+
+.empty-state h3 {
+  margin: 0 0 10px;
+  font-size: 1.5rem;
+}
+
+.empty-state p {
+  margin: 0;
+  color: var(--muted);
+}
+
+.method-grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 18px;
+}
+
+.method-item {
+  background: linear-gradient(180deg, rgba(255,255,255,0.025), rgba(255,255,255,0.01));
+  border-radius: var(--radius);
+  border: 1px solid var(--line);
+  padding: 22px 18px;
+  box-shadow: var(--shadow-soft);
+  transition: transform 0.2s ease, border-color 0.2s ease;
+}
+
+.method-item:hover {
+  transform: translateY(-2px);
+  border-color: rgba(73, 217, 160, 0.22);
+}
+
+.method-item span {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 42px;
+  height: 42px;
+  border-radius: 12px;
+  background: rgba(73,217,160,0.12);
+  border: 1px solid rgba(73,217,160,0.18);
+  color: var(--green);
+  font-weight: 800;
+  margin-bottom: 16px;
+}
+
+.method-item h3 {
+  margin: 0 0 10px;
+  font-size: 1.15rem;
+}
+
+.method-item p {
+  margin: 0;
+  color: var(--muted);
+  line-height: 1.8;
+}
+
+.site-footer {
+  border-top: 1px solid var(--line);
+  background: rgba(3, 13, 11, 0.88);
+}
+
+.footer-inner {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 18px;
+  min-height: 78px;
+  color: var(--muted);
+}
+
+@media (max-width: 980px) {
+  .hero,
+  .about-grid,
+  .project-grid,
+  .method-grid {
+    grid-template-columns: 1fr 1fr;
+  }
+
+  .hero {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (max-width: 720px) {
+  .topbar {
